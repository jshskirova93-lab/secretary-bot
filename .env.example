# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=

# Ключ Claude API (console.anthropic.com)
ANTHROPIC_API_KEY=

# Telegram user_id владельца (узнать через @userinfobot)
OWNER_CHAT_ID=

# Часовой пояс, например Europe/Moscow
TIMEZONE=Europe/Moscow

# Время утреннего плана и вечернего отчёта (ЧЧ:ММ)
MORNING_TIME=07:00
EVENING_TIME=21:00

# Путь к файлу базы данных
DB_PATH=secretary.db

# Google Calendar (опционально, см. README)
GOOGLE_CREDENTIALS_PATH=credentials.json
GOOGLE_TOKEN_PATH=token.json
GOOGLE_CALENDAR_ID=primary
